# Copy this file to .env and adjust values for your machine.
# Do NOT commit .env

# LM Studio OpenAI-compatible server (runs on the host)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct-uncensored
# Recommended embedding model: mxbai-embed-large-v1 (1024d, strong retrieval quality)
# Alternatives: nomic-embed-text-v1.5 (768d), text-embedding-3-small (OpenAI, 1536d)
# WARNING: changing embedding model requires re-ingesting all documents.
LM_STUDIO_EMBEDDING_MODEL=text-embedding-mxbai-embed-large-v1
LM_STUDIO_TIMEOUT_SECONDS=300
LM_STUDIO_EMBEDDING_BATCH_SIZE=16

# Local SentenceTransformer fallback (used when no LM Studio / Ollama embedding model is set)
# Recommended: BAAI/bge-base-en-v1.5 (768d) or BAAI/bge-large-en-v1.5 (1024d)
# Default: sentence-transformers/all-MiniLM-L6-v2 (384d — fast but lower quality)
# WARNING: changing this requires re-ingesting all documents.
# LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# LLM Routing — fast model (simple/factual queries)
# Defaults to LM_STUDIO_* above if not set
FAST_LLM_MODEL=your-small-fast-model-name
FAST_LLM_BASE_URL=http://localhost:1234/v1
FAST_LLM_TIMEOUT_SECONDS=60

# LLM Routing — large model (complex reasoning / synthesis)
# Defaults to LM_STUDIO_* above if not set
LARGE_LLM_MODEL=your-large-thinking-model-name
LARGE_LLM_BASE_URL=http://localhost:1234/v1
LARGE_LLM_TIMEOUT_SECONDS=300

# Ollama (alternative to LM Studio for embeddings)
# If OLLAMA_EMBEDDING_MODEL is set, it takes priority over LM_STUDIO_EMBEDDING_MODEL
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# Supabase (required for chat history and session persistence)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Qdrant API key if you enable it
# QDRANT_API_KEY=

# CrossRef polite pool — add your email so CrossRef can contact you if needed
# https://api.crossref.org/swagger-ui/index.html#/Works
CROSSREF_MAILTO=Herb.GPT@outlook.com
